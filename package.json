{
  "name": "phonedesk-agent",
  "version": "0.5.10",
  "private": true,
  "description": "PhoneDesk owner agent - installs on the owner's PC/Mac, runs ws-scrcpy, and brings the phone online for VAs.",
  "author": "PhoneDesk",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "core": "node agent.js",
    "webrtc-diagnose": "node tools/webrtc-diagnose.js",
    "test:rtp": "node tools/test_rtp.js && node tools/test_h265_rtp.js",
    "test:webrtc": "node tools/test_webrtc_negotiation.js && node tools/test_webrtc_switch.js",
    "test:freeze": "node tools/test-nonblocking.js && node tools/test-freeze-paths.js",
    "test:congestion": "node tools/test_congestion.js",
    "test:igpost": "node tools/test_igpost.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "test:airplane": "node tools/test_airplane.js",
    "ig-diagnose": "node tools/ig-status-diagnose.js",
    "rtp-check": "node tools/rtp-ffmpeg-check.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "werift": "^0.20.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
